{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ANTARA",
  "version": "1.0.0",
  "identifier": "app.solares.wallet",
  "build": {
    "beforeDevCommand": "node scripts/desktop-services.mjs",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build:app && node scripts/check-desktop-build.mjs --installer",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "ANTARA",
        "label": "main",
        "useHttpsScheme": true,
        "theme": "Dark",
        "backgroundColor": "#030303",
        "width": 1440,
        "height": 960,
        "minWidth": 900,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src ipc: http://ipc.localhost 'self' https: wss:; frame-src https://auth.privy.io https://verify.walletconnect.com https://verify.walletconnect.org; object-src 'none'; base-uri 'self'; worker-src 'self' blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "licenseFile": "installer/About-ANTARA.txt",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico"
      }
    }
  }
}
