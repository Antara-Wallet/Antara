# PUBLIC browser configuration. Never place secrets in a VITE_ variable.
VITE_PRIVY_APP_ID=
# Optional Privy app client ID for this build (Privy Dashboard > Clients, "client-...").
# Public. Use one client per platform: web, desktop (https://tauri.localhost) and
# extension (chrome-extension://ckfkljfbjkmkjkkjkpbnmoehfipdcoin). Empty uses the app defaults.
# Every build reads this file, so leave it empty here: put the extension's client ID in
# .env.extension.local (and .env.extension-dev.local for dev builds), and set the desktop
# or web client ID in the shell for that one build. A wrong client breaks login.
VITE_PRIVY_CLIENT_ID=
# Empty means same origin; Vite proxies /api to localhost:8787 during development.
# Packaged builds use the production API https://antara.tech: npm run desktop:build
# and npm run build:extension default to it when this is empty.
VITE_API_BASE=
# Public Solana address of the ANTARA guardian (paired vaults). Printed by
# scripts/provision-guardian.mjs; empty means paired vaults cannot be created.
VITE_ANTARA_GUARDIAN_SOLANA=
# Browser RPC credentials must be origin-restricted public client keys.
# The Solana endpoint must accept browser requests: https://api.mainnet-beta.solana.com
# answers HTTP 403 to any request with an Origin header (web, desktop and extension),
# so it works only for the server's SOLANA_RPC_URL. Empty uses solana-rpc.publicnode.com
# (keyless and rate-limited; production should use a domain-restricted provider URL).
VITE_SOLANA_CLUSTER=mainnet-beta
VITE_SOLANA_RPC_URL=https://solana-rpc.publicnode.com
VITE_SOLANA_WS_URL=wss://solana-rpc.publicnode.com
# Optional EVM wallet RPC overrides (Ethereum, BNB Smart Chain, Robinhood Chain, Base).
# Empty uses the pinned official/keyless public endpoint. Compiled into the public
# bundle: use only origin-restricted public URLs, never a private provider key.
VITE_ETHEREUM_RPC_URL=
VITE_BSC_RPC_URL=
VITE_ROBINHOOD_RPC_URL=
VITE_BASE_RPC_URL=
# Optional owned and verified release/community destinations. No upstream defaults.
VITE_COMMUNITY_URL=
VITE_DESKTOP_DOWNLOAD_URL=
VITE_UPDATE_MANIFEST_URL=
