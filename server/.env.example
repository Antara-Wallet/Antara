# ANTARA API. Copy to server/.env. Never commit credentials.
PORT=8787
# Proxy hops trusted for req.ip: a hop count or "false". Unset defaults to 1
# when NODE_ENV=production and false otherwise. "true" (trust every proxy) is
# rejected because it lets any client forge X-Forwarded-For. It keys per-IP rate
# limits and the Wi-Fi layer only when CLIENT_IP_HEADER is off.
TRUST_PROXY=
# Edge header naming the client for per-IP rate limits and the Wi-Fi layer:
# cf-connecting-ip or none. Unset means cf-connecting-ip on a
# Render web service (RENDER=true) and none elsewhere. Set it only behind an edge
# that overwrites or refuses a client's copy; leave it empty locally.
CLIENT_IP_HEADER=
PRIVY_APP_ID=
PRIVY_APP_SECRET=
RELAY_API_KEY=
# There are no Relay swap caps to configure (owner decision 2026-10-13): no
# per-swap or daily cap. Every swap is bounded only by the protocol sanity
# ceiling of 100,000 funding-stablecoin units, and every order check still runs.
# RELAY_MAX_TRADE_UNITS, RELAY_DAILY_MAX_UNITS and RELAY_MAX_DAILY_UNITS are no
# longer read.

# Match the browser cluster exactly. Relay routes are mainnet only.
SOLANA_CLUSTER=mainnet-beta
# Server-only RPCs (they may carry a provider key), one per supported network:
# Solana, Ethereum, BNB Smart Chain (56), Robinhood Chain (4663), Base (8453).
# Each must serve that exact chain; reads verify the EVM chain id or the Solana
# genesis hash and report a mismatch as a failed network. When one
# is empty the API uses the network's official public RPC, which is rate-limited.
# Setting a variable to that public RPC still reports rpcConfigured=false.
# Arbitrum and Polygon are no longer supported and have no variables.
SOLANA_RPC_URL=
ETHEREUM_RPC_URL=
BSC_RPC_URL=
ROBINHOOD_RPC_URL=
BASE_RPC_URL=

# Local development values. Production (Render) uses WEB_ORIGIN=https://antara.tech
# and ALLOWED_ORIGINS=https://antara.tech,https://www.antara.tech,https://tauri.localhost,chrome-extension://ckfkljfbjkmkjkkjkpbnmoehfipdcoin
WEB_ORIGIN=http://localhost:1420
ALLOWED_ORIGINS=http://localhost:1420,http://127.0.0.1:1420,https://tauri.localhost,tauri://localhost,https://antara.tech,https://www.antara.tech,chrome-extension://ckfkljfbjkmkjkkjkpbnmoehfipdcoin

# Legacy desktop API is isolated from the new Privy application.
# Do not enable on an internet-facing server without reviewing docs/SECURITY.md.
ANTARA_ENABLE_LEGACY_API=false
ALCHEMY_API_KEY=
GMGN_API_KEY=
SAFE_API_KEY=
COSIGNER_PRIVATE_KEY=
# Public EIP-55 (checksummed) address of the co-signer key. Paired-vault
# discovery uses it without loading COSIGNER_PRIVATE_KEY; it must be that key's
# address. When unset, discovery derives it from the private key (legacy).
COSIGNER_ADDRESS=
ANTARA_ADMIN_SECRET=
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=ANTARA Vault
WEBAUTHN_ORIGIN=http://localhost:1420
# Legacy policy/passkey storage and the paired-vault store must live on a
# backed-up persistent disk (Render: /var/data).
DATA_DIR=./data

# Solana paired vault guardian (docs/GUARDIAN.md). Created by
# `node scripts/provision-guardian.mjs`; never commit these values.
# ANTARA_GUARDIAN_AUTH_KEY is the server's P-256 authorization key (secret).
ANTARA_GUARDIAN_AUTH_KEY=
ANTARA_GUARDIAN_SOLANA_WALLET_ID=
ANTARA_GUARDIAN_SOLANA_ADDRESS=
ANTARA_GUARDIAN_POLICY_ID=
ANTARA_GUARDIAN_SIGNER_ID=
ANTARA_GUARDIAN_OWNER_QUORUM_ID=
# Owner switch: paired vaults stay off unless this is exactly "true". Set it
# only after `--verify-policy` and `--probe-user-jwt` pass and are recorded in
# docs/VERIFICATION.md.
ANTARA_PAIRED_VAULTS_ENABLED=
# There are no server release limits (owner decision 2026-10-13): no default
# cap, ceiling or minimum. A user may set their own per-release and daily caps
# with the vault's optional Limits layer. ANTARA_VAULT_SOL_PER_RELEASE,
# ANTARA_VAULT_USDC_PER_RELEASE, ANTARA_VAULT_SOL_PER_DAY and
# ANTARA_VAULT_USDC_PER_DAY are no longer read.
# Optional guardian vote-count ceilings. They only protect the guardian's fee
# SOL from abuse (they count votes, never value) and are set far above normal
# use. Defaults: 2000 per hour overall, 120 per account per hour, 2000 per
# account per day. Invalid values turn the guardian off (fail closed).
ANTARA_GUARDIAN_MAX_APPROVALS_PER_HOUR=
ANTARA_GUARDIAN_MAX_APPROVALS_PER_USER_HOUR=
ANTARA_GUARDIAN_MAX_APPROVALS_PER_USER_DAY=
# Vault protection layers (docs/VAULT_LAYERS.md). Server-only; never VITE_.
# A passkey (Biometrics) is required for every paired-vault release. Defaults:
# production RP ID antara.tech with origins https://antara.tech,
# https://tauri.localhost and the extension origin; elsewhere localhost with
# http://localhost:1420 instead of the web origin. An invalid value makes every
# passkey check answer 503 (nothing is approved). The legacy WEBAUTHN_* values
# above are not read by the layer code. Add the Chrome Web Store extension
# origin here when it is assigned. The Wi-Fi layer also needs the client IP in
# production: CLIENT_IP_HEADER on Render, else TRUST_PROXY set to the real proxy
# hop count. Every layer challenge is bound to
# the caller's Privy session id, which authentication records from the verified
# token (no variable; a token without one gets 503 on the layer routes; see
# docs/VAULT_LAYERS.md §9).
ANTARA_LAYER_RP_ID=
ANTARA_LAYER_ORIGINS=
# Vault authenticator (MFA layer, docs/VAULT_LAYERS.md): 32 random bytes as
# base64 (for example `node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"`).
# It seals each vault's TOTP secret (AES-256-GCM) in the vault store. Without a
# valid key nothing that needs the authenticator is enrolled or approved (503);
# it never turns MFA off. Server-only: never a VITE_ variable. Losing or
# changing it makes every enrolled authenticator unreadable (releases from
# those vaults pause until MFA is waived through a 7-day recovery), so back it
# up with the vault store and rotate only with a planned re-enrollment.
ANTARA_VAULT_TOTP_KEY=
# First start on a new production disk only; remove it after that start logs
# `antara.vault-store initialised`. Never set it to recover from a refusal.
# ANTARA_VAULT_STORE_INIT=1
