{
  "name": "antara-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Authenticated wallet data and validated cross-chain routing for ANTARA",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "test:ark": "tsx src/providers/policy.ark.test.ts",
    "sim:ark": "tsx src/providers/ark-sim.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/solares/*.test.ts && npm run test:policy",
    "test:policy": "tsx src/providers/policy.ark.test.ts"
  },
  "dependencies": {
    "@privy-io/node": "0.35.0",
    "@relay-protocol/settlement-sdk": "0.0.146",
    "@safe-global/api-kit": "^4.2.0",
    "@safe-global/protocol-kit": "^7.2.0",
    "@safe-global/safe-deployments": "1.37.63",
    "@safe-global/types-kit": "^3.1.0",
    "@simplewebauthn/server": "^13.3.1",
    "@solana/web3.js": "1.98.4",
    "bs58": "6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "qrcode": "^1.5.3",
    "viem": "^2.21.54"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "@types/qrcode": "^1.5.5",
    "@types/supertest": "6.0.3",
    "supertest": "7.2.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "overrides": {
    "ws": "8.22.0",
    "axios": "1.20.0",
    "uuid": "11.1.1",
    "toml": "5.0.0",
    "jayson": "5.0.0"
  }
